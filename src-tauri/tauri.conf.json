{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Libre Media Player",
  "version": "0.2.0",
  "identifier": "dev.libreflow.libre-media-player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Libre Media Player",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Libreflow",
    "resources": [
      "lib/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v"
        ],
        "name": "Vidéo MP4 QuickTime",
        "description": "Fichier vidéo",
        "role": "Viewer",
        "mimeType": "video/mp4"
      },
      {
        "ext": [
          "mov"
        ],
        "name": "Vidéo QuickTime",
        "description": "Fichier vidéo",
        "role": "Viewer",
        "mimeType": "video/quicktime"
      },
      {
        "ext": [
          "mkv"
        ],
        "name": "Vidéo Matroska",
        "description": "Fichier vidéo",
        "role": "Viewer",
        "mimeType": "video/x-matroska"
      },
      {
        "ext": [
          "webm"
        ],
        "name": "Vidéo WebM",
        "description": "Fichier vidéo",
        "role": "Viewer",
        "mimeType": "video/webm"
      },
      {
        "ext": [
          "avi"
        ],
        "name": "Vidéo AVI",
        "description": "Fichier vidéo",
        "role": "Viewer",
        "mimeType": "video/x-msvideo"
      },
      {
        "ext": [
          "flv"
        ],
        "name": "Vidéo Flash",
        "description": "Fichier vidéo",
        "role": "Viewer",
        "mimeType": "video/x-flv"
      },
      {
        "ext": [
          "wmv"
        ],
        "name": "Vidéo Windows Media",
        "description": "Fichier vidéo",
        "role": "Viewer",
        "mimeType": "video/x-ms-wmv"
      },
      {
        "ext": [
          "ts"
        ],
        "name": "Vidéo MPEG Transport Stream",
        "description": "Fichier vidéo",
        "role": "Viewer",
        "mimeType": "video/mp2t"
      },
      {
        "ext": [
          "mpg",
          "mpeg"
        ],
        "name": "Vidéo MPEG",
        "description": "Fichier vidéo",
        "role": "Viewer",
        "mimeType": "video/mpeg"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/libreflow/libre-media-player/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
