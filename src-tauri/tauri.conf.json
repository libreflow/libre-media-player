{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Libre Media Player",
  "version": "0.1.0",
  "identifier": "dev.libreflow.libre-media-player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Libre Media Player",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Libreflow",
    "resources": [
      "lib/**/*"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4", "m4v", "mov"],
        "name": "Vidéo MP4 QuickTime",
        "description": "Fichier vidéo",
        "role": "Viewer"
      },
      {
        "ext": ["mkv", "webm"],
        "name": "Vidéo Matroska WebM",
        "description": "Fichier vidéo",
        "role": "Viewer"
      },
      {
        "ext": ["avi"],
        "name": "Vidéo AVI",
        "description": "Fichier vidéo",
        "role": "Viewer"
      },
      {
        "ext": ["flv", "wmv", "ts", "mpg", "mpeg"],
        "name": "Vidéo",
        "description": "Fichier vidéo",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
